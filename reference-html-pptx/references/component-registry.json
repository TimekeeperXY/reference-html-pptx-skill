{
  "version": "1.0.0",
  "schema": "reference-html-pptx-component-registry",
  "principle": "Choose a component only when its information role and capacity fit the content; reuse the visual grammar, not a fixed page geometry.",
  "components": [
    {
      "id": "info-card-row",
      "label": "图标信息横卡",
      "family": "card",
      "relationTypes": ["classification", "parallel roles", "comparison", "collaboration", "cause-response"],
      "layoutFamilies": ["card-grid", "two-column", "four-up", "aligned-modules"],
      "contentSignals": ["icon", "short title", "one explanation", "peer facts", "parallel items"],
      "repeat": { "min": 2, "max": 6, "preferred": 4 },
      "capacity": { "titleChars": 18, "bodyLines": 2, "bodyChars": 58 },
      "slots": ["surface", "icon-badge", "icon", "title", "body", "accent-wedge"],
      "variants": ["icon-left", "icon-right", "compact"],
      "visualGrammar": { "boundary": "soft elevation", "silhouette": "wide rectangle with subtle lower accent", "icon": "filled circular badge", "rhythm": "icon → title → two-line explanation" },
      "export": { "group": true, "native": ["surface", "title", "body"], "svgImage": ["icon", "accent-wedge"], "rasterAllowed": ["complex shadow"], "groupName": "info-card-row instance" }
    },
    {
      "id": "ribbon-detail-card",
      "label": "角标详情卡",
      "family": "card",
      "relationTypes": ["classification", "comparison", "cause-response"],
      "layoutFamilies": ["three-column", "card-grid", "aligned-modules"],
      "contentSignals": ["corner ribbon", "year", "label", "two explanations", "vertical card"],
      "repeat": { "min": 2, "max": 4, "preferred": 3 },
      "capacity": { "titleChars": 16, "bodyLines": 6, "bodyChars": 150 },
      "slots": ["surface", "ribbon", "ribbon-label", "title", "body-primary", "body-secondary"],
      "variants": ["corner-ribbon", "top-tab", "plain"],
      "visualGrammar": { "boundary": "thin outline plus soft shadow", "silhouette": "tall rounded rectangle", "accent": "diagonal corner ribbon", "rhythm": "ribbon → title → separated explanations" },
      "export": { "group": true, "native": ["surface", "ribbon", "title", "body-primary", "body-secondary", "ribbon-label"], "svgImage": [], "rasterAllowed": ["soft shadow"], "groupName": "ribbon-detail-card instance" }
    },
    {
      "id": "metric-tile",
      "label": "关键指标瓦片",
      "family": "metric",
      "relationTypes": ["comparison", "classification", "cause-response"],
      "layoutFamilies": ["metric-led", "card-grid", "two-column", "four-up"],
      "contentSignals": ["large number", "unit", "label", "change", "short context"],
      "repeat": { "min": 2, "max": 6, "preferred": 3 },
      "capacity": { "titleChars": 14, "bodyLines": 2, "bodyChars": 48 },
      "slots": ["surface", "value", "unit", "label", "context", "trend"],
      "variants": ["accent-number", "split-value", "minimal"],
      "visualGrammar": { "boundary": "quiet surface or divider", "silhouette": "compact tile", "accent": "one large number", "rhythm": "value → label → context" },
      "export": { "group": true, "native": ["surface", "value", "unit", "label", "context", "trend"], "svgImage": [], "rasterAllowed": ["decorative sparkline"], "groupName": "metric-tile instance" }
    },
    {
      "id": "metric-ring",
      "label": "环形指标卡",
      "family": "metric",
      "relationTypes": ["comparison", "classification"],
      "layoutFamilies": ["metric-led", "four-up", "card-grid"],
      "contentSignals": ["percentage", "completion", "ring", "part-to-whole", "benchmark"],
      "repeat": { "min": 2, "max": 5, "preferred": 4 },
      "capacity": { "titleChars": 14, "bodyLines": 1, "bodyChars": 32 },
      "slots": ["surface", "chart", "center-value", "label", "context"],
      "variants": ["doughnut", "semi-ring", "ring-with-label"],
      "visualGrammar": { "boundary": "outlined or quiet card", "silhouette": "square metric module", "accent": "native doughnut chart", "rhythm": "ring → value → label" },
      "export": { "group": true, "native": ["surface", "center-value", "label", "context"], "chart": ["chart"], "svgImage": [], "rasterAllowed": [], "groupName": "metric-ring instance" }
    },
    {
      "id": "progress-row",
      "label": "进度比较行",
      "family": "evidence",
      "relationTypes": ["comparison", "classification", "cause-response"],
      "layoutFamilies": ["progress-list", "comparison-table", "evidence-led"],
      "contentSignals": ["progress", "score", "bar", "rank", "target"],
      "repeat": { "min": 2, "max": 8, "preferred": 4 },
      "capacity": { "titleChars": 18, "bodyLines": 1, "bodyChars": 42 },
      "slots": ["label", "value", "track", "fill", "annotation", "track-secondary", "fill-secondary", "rank"],
      "variants": ["single-bar", "dual-bar", "ranked"],
      "visualGrammar": { "boundary": "alignment and track", "silhouette": "compact horizontal row", "accent": "filled progress segment", "rhythm": "label → bar → value" },
      "export": { "group": true, "native": ["label", "value", "track", "fill", "annotation", "track-secondary", "fill-secondary", "rank"], "svgImage": [], "rasterAllowed": [], "groupName": "progress-row instance" }
    },
    {
      "id": "process-node",
      "label": "流程节点",
      "family": "process",
      "relationTypes": ["sequence", "handoff", "collaboration", "cause-response"],
      "layoutFamilies": ["flow", "timeline", "swimlane", "staged-pipeline"],
      "contentSignals": ["step", "stage", "handoff", "sequence", "connector"],
      "repeat": { "min": 2, "max": 7, "preferred": 4 },
      "capacity": { "titleChars": 16, "bodyLines": 3, "bodyChars": 72 },
      "slots": ["node-surface", "step-label", "title", "body", "connector", "status"],
      "variants": ["numbered", "icon-node", "swimlane-node"],
      "visualGrammar": { "boundary": "aligned node plus semantic connector", "silhouette": "compact module", "accent": "step marker", "rhythm": "step → title → detail → next" },
      "export": { "group": true, "native": ["node-surface", "step-label", "title", "body", "connector", "status"], "svgImage": [], "rasterAllowed": [], "groupName": "process-node instance" }
    },
    {
      "id": "comparison-panel",
      "label": "对比面板",
      "family": "comparison",
      "relationTypes": ["comparison", "classification"],
      "layoutFamilies": ["two-column", "comparison-table", "before-after"],
      "contentSignals": ["versus", "before", "after", "pros", "cons", "same dimensions"],
      "repeat": { "min": 2, "max": 2, "preferred": 2 },
      "capacity": { "titleChars": 18, "bodyLines": 8, "bodyChars": 180 },
      "slots": ["surface", "header", "title", "row", "highlight", "footer"],
      "variants": ["mirror", "before-after", "pros-cons"],
      "visualGrammar": { "boundary": "balanced panels", "silhouette": "mirrored columns", "accent": "one decisive difference", "rhythm": "header → parallel rows → conclusion" },
      "export": { "group": true, "native": ["surface", "header", "title", "row", "highlight", "footer"], "svgImage": [], "rasterAllowed": [], "groupName": "comparison-panel instance" }
    },
    {
      "id": "evidence-row",
      "label": "证据说明行",
      "family": "evidence",
      "relationTypes": ["evidence", "sequence", "cause-response", "classification"],
      "layoutFamilies": ["evidence-led", "progress-list", "timeline", "aligned-modules"],
      "contentSignals": ["evidence", "source", "finding", "detail", "note", "validation"],
      "repeat": { "min": 2, "max": 8, "preferred": 4 },
      "capacity": { "titleChars": 24, "bodyLines": 2, "bodyChars": 90 },
      "slots": ["marker", "title", "body", "source", "value", "divider"],
      "variants": ["marker-left", "value-right", "source-under"],
      "visualGrammar": { "boundary": "divider or whitespace", "silhouette": "row", "accent": "marker or value", "rhythm": "marker → finding → source/value" },
      "export": { "group": true, "native": ["marker", "title", "body", "source", "value", "divider"], "svgImage": [], "rasterAllowed": [], "groupName": "evidence-row instance" }
    },
    {
      "id": "status-chip",
      "label": "状态标签",
      "family": "label",
      "relationTypes": ["classification", "comparison", "cause-response"],
      "layoutFamilies": ["legend", "aligned-modules", "comparison-table"],
      "contentSignals": ["status", "state", "legend", "category", "priority"],
      "repeat": { "min": 2, "max": 8, "preferred": 4 },
      "capacity": { "titleChars": 12, "bodyLines": 0, "bodyChars": 0 },
      "slots": ["surface", "icon", "label", "value", "dot"],
      "variants": ["filled", "outline", "dot-label"],
      "visualGrammar": { "boundary": "pill or dot", "silhouette": "compact label", "accent": "semantic status color", "rhythm": "marker → label → optional value" },
      "export": { "group": true, "native": ["surface", "label", "value", "dot"], "svgImage": ["icon"], "rasterAllowed": [], "groupName": "status-chip instance" }
    },
    {
      "id": "quote-block",
      "label": "引用观点块",
      "family": "narrative",
      "relationTypes": ["evidence", "cause-response", "comparison"],
      "layoutFamilies": ["quote-led", "evidence-led", "main-module-context"],
      "contentSignals": ["quote", "opinion", "principle", "source", "takeaway"],
      "repeat": { "min": 1, "max": 2, "preferred": 1 },
      "capacity": { "titleChars": 0, "bodyLines": 4, "bodyChars": 120 },
      "slots": ["surface", "accent-bar", "quote-mark", "text", "source"],
      "variants": ["accent-bar", "large-quote", "source-under"],
      "visualGrammar": { "boundary": "soft elevated surface", "silhouette": "wide rounded block", "accent": "vertical rule", "rhythm": "quote → source" },
      "export": { "group": true, "native": ["surface", "accent-bar", "quote-mark", "text", "source"], "svgImage": [], "rasterAllowed": [], "groupName": "quote-block instance" }
    }
  ]
}
